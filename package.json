{
  "name": "graph-dsl",
  "version": "0.1.0",
  "description": "A typed graph query DSL that emits a portable AST and compiles to graph backends.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "graph",
    "dsl",
    "cypher",
    "gremlin",
    "neo4j"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/KarolCislowski/graph-dsl.git"
  },
  "bugs": {
    "url": "https://github.com/KarolCislowski/graph-dsl/issues"
  },
  "homepage": "https://github.com/KarolCislowski/graph-dsl#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsup": "^8.5.0",
    "typescript": "^5.5.3",
    "vitest": "^5"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
